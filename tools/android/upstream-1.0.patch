+/* A NULL buffer queries the number of bytes to allocate. The second call
+ * writes NUL-terminated names in index order and reports the entry count. */
+static int Opcode_Sys81_ArchiveNames(OpenBGI_t* o, Thread_t* t) // 81 39: buf, out, path → out or 0
+{
+	const char* path = (const char*)PopPtr(o, t);
+	uint32_t output = Thread_Pop(t);
+	void* result = ResolvePtr(o, output, t);
+	char* buffer = (char*)PopPtr(o, t);
+	ArcRead_t* archive = path ? Fs_OpenGameArchive(o, path) : NULL;
+	uint32_t value = 0;
+	if(archive)
+	{
+		for(uint32_t i = 0; i < archive->count; i++)
+		{
+			const char* name = archive->entries[i].name;
+			size_t n = strlen(name) + 1;
+			if(buffer)
+				memcpy(buffer + value, name, n);
+			value += (uint32_t)n;
+		}
+		if(buffer)
+			value = archive->count;
+	}
+	if(result)
+		memcpy(result, &value, sizeof value);
+	Thread_Push(t, archive ? output : 0);
+	ArcRead_Close(archive);
+	return 0;
+}
+
 /* the archive file `name` (base directory, then the alternative one) has
  * its index read again on its next use: 0 found, 1 not (ReloadArchive) */
