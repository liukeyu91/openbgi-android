+ * anything is written, also when the ranges overlap. */
+static int Opcode_VectorNormalize(OpenBGI_t* o, Thread_t* t) // 5D (1.636 on): dst, src →
+{
+	const void* src = PopPtr(o, t);
+	void* dst = PopPtr(o, t);
+	int32_t input[4];
+	uint32_t output[4] = {0, 0, 0, 0};
+	float x, y, z, inverse;
+	volatile float xx, yy, zz, sum;
+	memcpy(input, src, sizeof input);
+	x = (float)input[0] * (1.0f / 65536.0f);
+	y = (float)input[1] * (1.0f / 65536.0f);
+	z = (float)input[2] * (1.0f / 65536.0f);
+	xx = x * x;
+	yy = y * y;
+	zz = z * z;
