+		uint32_t bgmMasterVolume[BGM_CHANNELS]; // 0 .. 0x80 per channel
+		uint32_t seMasterVolume[SE_SLOTS];      // 0 .. 0x80 per slot
+		uint8_t seDesc[SE_SLOTS][SE_DESC_SIZE]; // the loaded effects' descriptors
