+static int Opcode_StoreLocal(OpenBGI_t* o, Thread_t* t) // 0F (1.680): v →
+{
+	uint32_t type;
+	uint8_t* slot = ReadLocalSlot(o, t, &type);
+	StoreSized(slot, type, Thread_Pop(t));
+	return 0;
+}
+
+static uint32_t ReadLocalValue(OpenBGI_t* o, Thread_t* t)
+{
+	uint32_t type;
+	const uint8_t* slot = ReadLocalSlot(o, t, &type);
+	return LoadSized(slot, type);
+}
+
+static int Opcode_LoadLocal(OpenBGI_t* o, Thread_t* t) // 19 (1.680): → v
+{
+	Thread_Push(t, ReadLocalValue(o, t));
+	return 0;
+}
+static int Opcode_LoadLocals680(OpenBGI_t* o, Thread_t* t) // E3: → v...
+{
+	unsigned count;
+	if(t->ip >= t->codeUsed)
+		ScriptError(o, "Truncated local count", t);
+	count = (unsigned)RdU8(t) + 1;
+	for(unsigned i = 0; i < count; ++i)
+		Thread_Push(t, ReadLocalValue(o, t));
+	return 0;
+}
+
+static int Opcode_LoadAbsolute680(OpenBGI_t* o, Thread_t* t) // 18: → v
+{
+	uint32_t operand, type;
+	if(t->ip > t->codeUsed || t->codeUsed - t->ip < 4)
+		ScriptError(o, "Truncated absolute address", t);
