 }
 
+// the frame pointer a program's local references are measured from
+static void SetFP(Asm_t* a, uint32_t v)
+{
+	PushI32(a, v);
+	A8(a, 0x11);
+}
+
+// a dword of the data area, as the programs below read it through their locals
+static void PutDword(Thread_t* t, uint32_t at, uint32_t v)
+{
+	memcpy(t->data + at, &v, 4);
+}
