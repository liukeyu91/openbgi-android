diff --git a/src/core/textcp.c b/src/core/textcp.c
new file mode 100644
index 0000000000000000000000000000000000000000..242910b1cfa5b066902aa32798166e886e7d315d
--- /dev/null
+++ b/src/core/textcp.c
@@ -0,0 +1,106 @@
+/*
+ * This file is part of OpenBGI (https://openbgi.net).
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * textcp.c - the CP936 and CP950 code pages (inc/bgi/textcp.h)
+ *
+ * Not part of the original engine: a translated game's script text is Chinese
+ * in GBK or Big5, so the Android fork adds those two modes beside Shift-JIS and
+ * UTF-8.  The tables come from Unicode's Microsoft mapping tables, generated by
+ * tools/ (see the notices inside the two .inc files); the forward table is
+ * indexed by lead byte 0x81..0xFE and trail byte 0x40..0xFE without 0x7F, and
+ * the reverse one stores the lowest packed code of each Unicode scalar, in
+ * scalar order, so a binary search works.
+ */
+#include "bgi/textcp.h"
+
+#include "cp936.inc"
+#include "cp950.inc"
+
+// the offset of a GBK sequence in the forward table; -1 when it is not one
+static int GbkIndex(uint8_t lead, uint8_t trail)
+{
+	if(lead < 0x81 || lead > 0xfe || trail < 0x40 || trail > 0xfe || trail == 0x7f)
+		return -1;
+	return (lead - 0x81) * 190 + trail - 0x40 - (trail > 0x7f);
+}
+
+int TextCp_GbkCharLen(const char* s)
+{
+	uint8_t lead = (uint8_t)s[0];
+	return lead >= 0x81 && lead <= 0xfe && GbkIndex(lead, (uint8_t)s[1]) >= 0 ? 2 : 1;
+}
+
+uint32_t TextCp_GbkToCodePoint(uint16_t code)
+{
+	int index;
+	if(code < 0x80)
+		return code;
+	if(code == 0x80)
+		return 0x20ac; // the euro sign, where CP936 puts it
+	index = GbkIndex((uint8_t)(code >> 8), (uint8_t)code);
+	return index >= 0 && kCp936[index] ? kCp936[index] : 0xfffd;
+}
+
+uint16_t TextCp_CodePointToGbk(uint32_t cp)
+{
+	size_t lo = 0, hi = BGI_COUNTOF(kCp936ByUnicode);
+	if(cp < 0x80)
+		return (uint16_t)cp;
+	if(cp == 0x20ac)
+		return 0x80;
+	while(lo < hi)
+	{
+		size_t mid = lo + (hi - lo) / 2;
+		if(TextCp_GbkToCodePoint(kCp936ByUnicode[mid]) < cp)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return lo < BGI_COUNTOF(kCp936ByUnicode) && TextCp_GbkToCodePoint(kCp936ByUnicode[lo]) == cp
+		? kCp936ByUnicode[lo] : 0;
+}
+
+// the offset of a Big5 sequence in the forward table; -1 when it is not one
+static int Big5Index(uint8_t lead, uint8_t trail)
+{
+	if(lead < 0x81 || lead > 0xfe)
+		return -1;
+	if(trail >= 0x40 && trail <= 0x7e)
+		return (lead - 0x81) * 157 + trail - 0x40;
+	if(trail >= 0xa1 && trail <= 0xfe)
+		return (lead - 0x81) * 157 + 63 + trail - 0xa1;
+	return -1;
+}
+
+int TextCp_Big5CharLen(const char* s)
+{
+	uint8_t lead = (uint8_t)s[0];
+	return lead >= 0x81 && lead <= 0xfe && Big5Index(lead, (uint8_t)s[1]) >= 0 ? 2 : 1;
+}
+
+uint32_t TextCp_Big5ToCodePoint(uint16_t code)
+{
+	int index;
+	if(code < 0x80)
+		return code;
+	index = Big5Index((uint8_t)(code >> 8), (uint8_t)code);
+	return index >= 0 && kCp950[index] ? kCp950[index] : 0xfffd;
+}
+
+uint16_t TextCp_CodePointToBig5(uint32_t cp)
+{
+	size_t lo = 0, hi = BGI_COUNTOF(kCp950ByUnicode);
+	if(cp < 0x80)
+		return (uint16_t)cp;
+	while(lo < hi)
+	{
+		size_t mid = lo + (hi - lo) / 2;
+		if(TextCp_Big5ToCodePoint(kCp950ByUnicode[mid]) < cp)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return lo < BGI_COUNTOF(kCp950ByUnicode) && TextCp_Big5ToCodePoint(kCp950ByUnicode[lo]) == cp
+		? kCp950ByUnicode[lo] : 0;
+}
