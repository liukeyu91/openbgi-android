+/* A sized scalar access in 1.680 must fit its area or allocated pool slot. */
+uint8_t* ResolveScalar680(OpenBGI_t* o, uint32_t ptr, Thread_t* t, uint32_t width)
+{
+	uint32_t tag = ptr >> VM_TAG_SHIFT(o);
+	uint32_t off = ptr & VM_OFFSET_MASK(o);
+	uint32_t limit = 0;
+	if(tag == 0)
+		limit = o->mem.globalMemSize;
+	else if(tag == o->engine.profile->tagCode)
+		limit = t->codeSize;
+	else if(tag == o->engine.profile->tagData)
+		limit = t->dataSize;
+	else if(tag == o->engine.profile->tagHeap)
+		limit = t->heap ? t->heap->size : 0;
+	else
+	{
+		uint32_t slot;
+		DynPool_t* pool = DynPool_Of(o, tag, off, &slot);
+		if(pool && pool->blocks && pool->blocks[slot])
+		{
+			limit = pool->sizes[slot];
+			off &= (1u << pool->bits) - 1u;
+		}
+	}
+	if(!ptr || off >= limit || width > limit - off)
+		ScriptError(o, "Scalar reference lies outside its memory area", t);
+	return (uint8_t*)ResolvePtr(o, ptr, t);
+}
