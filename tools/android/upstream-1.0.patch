+int Gfx1_FaceExtension680(OpenBGI_t* o, const char* face, const int32_t* values, uint32_t count)
+{
+	FaceAdjust_t* a;
+	int32_t sx, sy, dx, dy, spacing, sxv;
+	if(count != 4 && count != 5)
+		return 8;
+	if(!face || !*face || strlen(face) >= sizeof a->face)
+		return 4;
+	sx = values[0];
+	sy = values[1];
+	dx = values[2];
+	dy = values[3];
+	spacing = count == 5 ? values[4] : 0;
+	if(spacing < -0x10000 || spacing > 0x10000)
+		return 7;
