+/* raise a script error with a printf-style message (formatted into a local
+ * buffer as the original does; ScriptError never returns) */
+#define SYS_ERROR(o, t, ...)        \
+	do                              \
+	{                               \
+		char msg_[0x104];           \
+		sprintf(msg_, __VA_ARGS__); \
+		ScriptError(o, msg_, (t));  \
+	} while(0)
