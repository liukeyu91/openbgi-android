+// ---- fixed-point and vector arithmetic (1.573 / 1.636 on) ------------------
+
+/* The builds from 1.573 added a length for a vector and those from 1.636 a
+ * fixed-point multiply and divide with four-lane vector forms.  The values
+ * are 16.16 fixed point; a vector is four of them, 16 bytes, addressed by
+ * the tagged pointers on the stack.  The original's SIMD kernels read both
+ * operands before writing (the component multiply and the scalar one
+ * instead walk the lanes in ascending order, which shows on partial
+ * overlap), and its reciprocal square root is refined in single precision:
+ * the portable code here keeps the same arithmetical results, not the
+ * instruction sequence. */
+
+// a float in 16.16, rounded as the original's conversions do
+static uint32_t VectorFixed(float value)
+{
+	float scaled = value * 65536.0f;
+	uint32_t result, whole, fraction;
+	if(!(scaled >= -2147483648.0f && scaled < 2147483648.0f))
+		result = 0x80000000u;
+	else
+		result = (uint32_t)(int32_t)nearbyintf(scaled);
+	whole = result & 0xffff0000u;
+	fraction = result - whole;
+	if(fraction < 64)
+		return whole;
+	if(fraction > 0xffc0)
+		return whole + 0x10000u;
+	return result;
+}
+
+// the low dword of the signed 64-bit product, shifted right by 16
+static uint32_t FixedMultiply(int32_t a, int32_t b)
+{
+	return (uint32_t)((uint64_t)((int64_t)a * b) >> 16);
+}
+
+// 16.16 division, in single precision as the original's reciprocal refinement
+static uint32_t FixedDivide(int32_t a, int32_t b)
+{
+	float numerator = (float)a * (1.0f / 65536.0f);
+	float denominator = (float)b * (1.0f / 65536.0f);
+	return b ? VectorFixed(numerator / denominator) : 0;
+}
+
+static int Opcode_Fixmul(OpenBGI_t* o, Thread_t* t) // 56 (1.636 on): a, b → product
+{
+	int32_t b = (int32_t)Thread_Pop(t), a = (int32_t)Thread_Pop(t);
+	Thread_Push(t, FixedMultiply(a, b));
+	return 0;
+}
+
+static int Opcode_Fixdiv(OpenBGI_t* o, Thread_t* t) // 57 (1.636 on): a, b → quotient
+{
+	int32_t b = (int32_t)Thread_Pop(t), a = (int32_t)Thread_Pop(t);
+	Thread_Push(t, FixedDivide(a, b));
+	return 0;
+}
+
+// the four-lane forms: add, subtract, component multiply, component divide
+static void VectorBinary(OpenBGI_t* o, Thread_t* t, int op)
+{
+	const uint8_t* b = (const uint8_t*)PopPtr(o, t);
+	const uint8_t* a = (const uint8_t*)PopPtr(o, t);
+	uint8_t* dst = (uint8_t*)PopPtr(o, t);
+	uint32_t av[4], bv[4], result[4];
+	int i;
+	if(op == 2)
+	{
+		for(i = 0; i < 4; i++)
+		{
+			int32_t x, y;
+			uint32_t value;
+			memcpy(&x, a + i * 4, 4);
+			memcpy(&y, b + i * 4, 4);
+			value = FixedMultiply(x, y);
+			memcpy(dst + i * 4, &value, 4);
+		}
+		return;
+	}
+	memcpy(av, a, sizeof av);
+	memcpy(bv, b, sizeof bv);
+	for(i = 0; i < 4; i++)
+		result[i] = op == 0 ? av[i] + bv[i] : op == 1 ? av[i] - bv[i] : FixedDivide((int32_t)av[i], (int32_t)bv[i]);
+	memcpy(dst, result, sizeof result);
+}
+
+static int Opcode_Vadd(OpenBGI_t* o, Thread_t* t) // 58 (1.636 on): dst, a, b →
+{
