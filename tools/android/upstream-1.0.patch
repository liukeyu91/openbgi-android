+/* one link: "<Programs>\<p1>\<p2>" -> p3, or "<Desktop>\<p2>" when p1 is
+ * NULL (the folder is created as needed); r 1 when made */
+static int Opcode_Sys_CreateShortcut(OpenBGI_t* o, Thread_t* t) // 80 F7: p1, p2, p3 → r
+{
