+// the number of files matching `pattern`, sub-directories entered when `recurse` is set
+static int Opcode_Sys_CountFiles(OpenBGI_t* o, Thread_t* t) // 80 24: pattern, recurse → n
+{
+	uint32_t recurse = Thread_Pop(t);
+	const char* pattern = (const char*)PopPtr(o, t);
+	Thread_Push(t, (uint32_t)FindFiles(o, NULL, pattern, (int)recurse, o->files.emptyPath, -1));
+	return 0;
+}
+
+/*
+ * A zero max imposes no limit. A NULL buffer queries the bytes needed for
+ * the packed names. A supplied buffer receives the names and returns the
+ * count, or -1 if its capacity is too small.
+ */
+static int Opcode_Sys_ListFiles(OpenBGI_t* o, Thread_t* t) // 80 25: buf, bufSize, pattern, recurse, max → n
+{
+	uint32_t max = Thread_Pop(t);
+	uint32_t recurse = Thread_Pop(t);
+	const char* pattern = (const char*)PopPtr(o, t);
+	uint32_t bufSize = Thread_Pop(t);
+	char* buf = (char*)PopPtr(o, t);
+	int limit = max && max < INT_MAX ? (int)max : INT_MAX;
+	int allocated = FindFiles(o, NULL, pattern, (int)recurse, NULL, limit);
+	if(allocated <= 0)
+	{
+		Thread_Push(t, 0);
+		return 0;
+	}
+	char** names = (char**)BGI_Alloc((size_t)allocated * sizeof *names);
+	for(int i = 0; i < allocated; i++)
+		names[i] = (char*)BGI_Alloc(0x104);
+	int found = FindFiles(o, names, pattern, (int)recurse, NULL, allocated);
+	uint64_t bytes = 0;
+	for(int i = 0; i < found; i++)
+		bytes += strlen(names[i]) + 1;
+	if(buf && bytes <= bufSize)
+	{
+		for(int i = 0; i < found; i++)
+		{
+			size_t len = strlen(names[i]) + 1;
+			memcpy(buf, names[i], len);
+			buf += len;
+		}
+	}
+	for(int i = 0; i < allocated; i++)
+		BGI_Free(names[i]);
+	BGI_Free(names);
+	Thread_Push(t, buf ? (bytes <= bufSize ? (uint32_t)found : UINT32_MAX)
+		: (bytes <= UINT32_MAX ? (uint32_t)bytes : UINT32_MAX));
+	return 0;
+}
+
+/* 80 26: buf, bufSize, pattern, max → count (or the bytes needed, buffer NULL)
+ * The directory-only sibling of "80 25": every entry the pattern matches that
+ * is a directory, "." and ".." left out.  A buffer too small answers -1. */
+static int Opcode_Sys_ListDirectories(OpenBGI_t* o, Thread_t* t)
+{
+	uint32_t max = Thread_Pop(t);
+	const char* pattern = (const char*)PopPtr(o, t);
+	uint32_t bufSize = Thread_Pop(t);
+	char* buf = (char*)PopPtr(o, t);
+	OpenBGI_FindData_t entry;
+	HostFind_t* find = Host_FindFirst(o, pattern, &entry);
+	uint32_t bytes = 0, count = 0;
+	int fits = 1;
+	if(find)
+	{
+		do
+		{
+			size_t n;
+			if(!(entry.attrs & OPENBGI_ATTR_DIRECTORY) || !strcmp(entry.name, ".") || !strcmp(entry.name, ".."))
+				continue;
+			if(max && count >= max)
+				break;
+			n = strlen(entry.name) + 1;
+			if(buf)
+			{
+				if(n <= bufSize && fits)
+				{
+					memcpy(buf, entry.name, n);
+					buf += n;
+					bufSize -= (uint32_t)n;
+				}
+				else
+					fits = 0;
+			}
+			bytes += (uint32_t)n;
+			++count;
+		} while(Host_FindNext(o, find, &entry));
+		Host_FindClose(o, find);
+	}
+	Thread_Push(t, !buf ? bytes : fits ? count : 0xffffffffu);
+	return 0;
+}
