+/* delete the links "<Desktop>\<p1>", "<Programs>\<p3>\<p1>" and
+ * "<Programs>\<p3>\<p2>", then the folder <p3> itself when f is set */
+static int Opcode_Sys_DeleteShortcuts(OpenBGI_t* o, Thread_t* t) // 80 F6: p1, p2, p3, f →
+{
