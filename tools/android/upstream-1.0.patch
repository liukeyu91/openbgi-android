diff --git a/tests/textcp.c b/tests/textcp.c
new file mode 100644
index 0000000000000000000000000000000000000000..99e33b9769f207b4f0e94e8236d3f32bad92891a
--- /dev/null
+++ b/tests/textcp.c
@@ -0,0 +1,115 @@
+/*
+ * This file is part of OpenBGI (https://openbgi.net).
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * tests/textcp.c - unit test of the CP936 and CP950 tables
+ *                  (src/core/textcp.c, src/include/bgi/textcp.h)
+ *
+ * The Android fork adds GBK and Big5 beside Shift-JIS and UTF-8, for the
+ * translated scripts whose text is Chinese:
+ *
+ *   decode    - a character of each part of both code pages, the euro sign
+ *               where CP936 keeps it, a lead byte without a trail
+ *   encode    - the packed code Windows picks for a scalar, and the scalars
+ *               the code page cannot write
+ *   roundtrip - every mapped code decodes to a scalar that encodes back to it
+ */
+#include "bgi/textcp.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "check.h"
+
+static void TestDecode(void)
+{
+	// 你 (U+4F60) is C4 E3 in GBK, A7 41 in Big5
+	CHECK(TextCp_GbkCharLen("\xc4\xe3") == 2);
+	CHECK(TextCp_GbkToCodePoint(0xc4e3) == 0x4f60);
+	CHECK(TextCp_Big5CharLen("\xa7\x41") == 2);
+	CHECK(TextCp_Big5ToCodePoint(0xa741) == 0x4f60);
+	// 的 (U+7684) and the full-width comma of both pages
+	CHECK(TextCp_GbkToCodePoint(0xb5c4) == 0x7684);
+	CHECK(TextCp_GbkToCodePoint(0xa3ac) == 0xff0c);
+	CHECK(TextCp_Big5ToCodePoint(0xa141) == 0xff0c);
+	// 油 (U+6CB9) is AA6F in Big5, a code CP936 spells elsewhere
+	CHECK(TextCp_Big5ToCodePoint(0xaa6f) == 0x6cb9);
+	// the euro sign sits at 0x80 in CP936
+	CHECK(TextCp_GbkToCodePoint(0x0080) == 0x20ac);
+	// ASCII passes through untouched
+	CHECK(TextCp_GbkToCodePoint(0x0041) == 0x41);
+	CHECK(TextCp_Big5ToCodePoint(0x0041) == 0x41);
+	// a lead byte with a trail that is not one of the page, and a lone trail
+	CHECK(TextCp_GbkCharLen("\xc4\x20") == 1);
+	CHECK(TextCp_Big5CharLen("\xa7\x20") == 1);
+	CHECK(TextCp_GbkCharLen("\x20") == 1);
+	CHECK(TextCp_GbkToCodePoint(0xc420) == 0xfffd);
+}
+
+static void TestEncode(void)
+{
+	CHECK(TextCp_CodePointToGbk(0x4f60) == 0xc4e3);
+	CHECK(TextCp_CodePointToBig5(0x4f60) == 0xa741);
+	CHECK(TextCp_CodePointToGbk(0x20ac) == 0x80);
+	CHECK(TextCp_CodePointToGbk(0x41) == 0x41);
+	// a scalar neither page has
+	CHECK(TextCp_CodePointToGbk(0x1f600) == 0);
+	CHECK(TextCp_CodePointToBig5(0x1f600) == 0);
+}
+
+// every mapped code decodes to a scalar that encodes back to the same code or
+// to the code of the same character the page prefers
+static void TestRoundTrip(void)
+{
+	uint32_t lead, trail, checked = 0, failed = 0;
+	for(lead = 0x81; lead <= 0xfe; ++lead)
+	{
+		for(trail = 0x40; trail <= 0xfe; ++trail)
+		{
+			char bytes[3] = {(char)lead, (char)trail, 0};
+			uint16_t code, back;
+			uint32_t cp;
+			if(TextCp_GbkCharLen(bytes) == 2)
+			{
+				code = (uint16_t)((lead << 8) | trail);
+				cp = TextCp_GbkToCodePoint(code);
+				checked++;
+				// an unmapped code decodes to U+FFFD, which has no code of its own
+				if(cp != 0xfffd)
+				{
+					back = TextCp_CodePointToGbk(cp);
+					if(back != code && TextCp_GbkToCodePoint(back) != cp)
+						failed++;
+				}
+			}
+			if(TextCp_Big5CharLen(bytes) == 2)
+			{
+				code = (uint16_t)((lead << 8) | trail);
+				cp = TextCp_Big5ToCodePoint(code);
+				checked++;
+				if(cp != 0xfffd)
+				{
+					back = TextCp_CodePointToBig5(cp);
+					if(back != code && TextCp_Big5ToCodePoint(back) != cp)
+						failed++;
+				}
+			}
+		}
+	}
+	CHECK(checked > 20000); // both pages together
+	CHECK(failed == 0);
+}
+
+int main(void)
+{
+	TestDecode();
+	TestEncode();
+	TestRoundTrip();
+	if(gFails)
+	{
+		printf("textcp: %d checks failed\n", gFails);
+		return 1;
+	}
+	printf("textcp: all tests passed\n");
+	return 0;
+}
