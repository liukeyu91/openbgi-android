-	f = Fs_FileOpenRead(o, path);
-	if(f && Fs_FileSize(f) == sizeof buf)
-		n = Fs_FileRead(f, buf, sizeof buf);
-	Fs_FileClose(f);
-	return n == sizeof buf && memcmp(buf, "0123456789ABCDEF", sizeof buf) == 0;
-}
