+static uint32_t LoadSized(const uint8_t* p, uint32_t sz)
+{
+	uint32_t v;
+	switch(sz)
+	{
+		case 0: v = (uint32_t)(int32_t)(int8_t)p[0]; break;
+		case 1:
+		{
+			int16_t s;
+			memcpy(&s, p, 2);
+			v = (uint32_t)(int32_t)s;
+			break;
+		}
+		case 2: memcpy(&v, p, 4); break;
+		default: v = 0; break;
+	}
+	return v;
+}
