+// 92 0E (1.680): face, count, values →.  The values are sx, sy, dx, dy
+// and, when count is 5, tracking.
+static int Opcode_Gfx2_SetFaceExtension(OpenBGI_t* o, Thread_t* t)
+{
+	uint32_t address = Thread_Pop(t), count = Thread_Pop(t);
+	const char* face = (const char*)PopPtr(o, t);
+	int32_t values[5] = {0};
+	int result;
+	if(count != 4 && count != 5)
+		GFX_ERROR(o, t, "Invalid font extension parameter count (%u)", (unsigned)count);
+	memcpy(values, ResolveScalar680(o, address, t, count * sizeof(int32_t)), count * sizeof(int32_t));
+	result = Gfx1_FaceExtension680(o, face, values, count);
+	switch(result)
+	{
+		case 4: GFX_ERROR(o, t, "Invalid font face name"); break;
+		case 5: GFX_ERROR(o, t, MSG_BAD_FACE_SCALE, (unsigned)values[0], (unsigned)values[1]); break;
+		case 6: GFX_ERROR(o, t, MSG_BAD_FACE_COORDS, (unsigned)values[2], (unsigned)values[3]); break;
+		case 7: GFX_ERROR(o, t, "Invalid font spacing adjustment (%.3f)", values[4] / 65536.0); break;
+		case 8: GFX_ERROR(o, t, "Invalid font extension parameter count (%u)", (unsigned)count); break;
+	}
+	return 0;
+}
+
+// 92 0F (1.680): face, spacing →
+static int Opcode_Gfx2_SetFaceSpacing(OpenBGI_t* o, Thread_t* t)
+{
+	int32_t spacing = (int32_t)Thread_Pop(t);
+	const char* face = (const char*)PopPtr(o, t);
+	int result = Gfx1_FaceSpacing680(o, face, spacing);
+	if(result == 7)
+		GFX_ERROR(o, t, "Invalid font spacing adjustment (%.3f)", spacing / 65536.0);
+	if(result == 4)
+		GFX_ERROR(o, t, "Invalid font face name");
+	return 0;
+}
