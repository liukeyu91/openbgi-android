+static void TestArchiveNames(OpenBGI_t* o)
+{
+	static const char path[] = "bin/test_vm_names.arc";
+	static const char names[] = "Zeta.dat\0\x95\xb6.txt";
+	static const struct { const char* magic; size_t recordSize; const char* profile; } formats[] = {
+		{"PackFile    ", 32, "1.616"}, {"BURIKO ARC20", 128, "1.636"},
+	};
+	uint8_t* d = gT->data;
+	uint32_t result;
+	printf("archive names\n");
+	strcpy((char*)d + 0x200, path);
+	remove(path);
+	for(size_t i = 0; i < sizeof formats / sizeof formats[0]; i++)
+	{
+		uint8_t archive[16 + 2 * 128] = {0};
+		size_t stride = formats[i].recordSize;
+		size_t size = 16 + 2 * stride;
+		FILE* f = fopen(path, "wb");
+		CHECK(f != NULL);
+		if(!f)
+			return;
+		memcpy(archive, formats[i].magic, 12);
+		archive[12] = 2;
+		memcpy(archive + 16, names, sizeof "Zeta.dat");
+		memcpy(archive + 16 + stride, names + sizeof "Zeta.dat", sizeof names - sizeof "Zeta.dat");
+		CHECK(fwrite(archive, 1, size, f) == size);
+		CHECK(fclose(f) == 0);
+		CHECK(Engine_SelectProfile(o, formats[i].profile));
+		Vm_TablesInit(o);
+		uint32_t out = DataPtr(o, 0x280);
+		uint32_t args[] = {0, out, DataPtr(o, 0x200)};
+		CHECK(Call(o, 0x81, 0x39, args, 3) == out);
+		memcpy(&result, d + 0x280, sizeof result);
+		CHECK(result == sizeof names);
+		memset(d + 0x300, 0x5a, sizeof names + 1);
+		args[0] = DataPtr(o, 0x300);
+		CHECK(Call(o, 0x81, 0x39, args, 3) == out);
+		memcpy(&result, d + 0x280, sizeof result);
+		CHECK(result == 2);
+		CHECK(memcmp(d + 0x300, names, sizeof names) == 0);
+		CHECK(d[0x300 + sizeof names] == 0x5a);
+		CHECK(remove(path) == 0);
+		CHECK(Call(o, 0x81, 0x39, args, 3) == 0);
+		memcpy(&result, d + 0x280, sizeof result);
+		CHECK(result == 0 && memcmp(d + 0x300, names, sizeof names) == 0);
+	}
+	CHECK(Engine_SelectProfile(o, "1.69/444"));
+	Vm_TablesInit(o);
+}
