+			if(strcmp(a->face, face) == 0)
+			{
+				a->sx = a->sy = a->dx = a->dy = 0;
+				a->spacing = spacing;
+			}
+		return 0;
+	}
+	if((sx != 0 && (sx < 0x10000 || sx > 0x20000)) || sy < 0x10000 || sy > 0x20000)
+		return 5;
+	sxv = sx ? sx : sy;
