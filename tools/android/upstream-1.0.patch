-{
-	uint32_t h = Thread_Pop(t), w = Thread_Pop(t);
-	const void* src = PopPtr(o, t);
-	void* dst = PopPtr(o, t);
-	Thread_SetWait(o, t, WaitEncode2_New(o, t, dst, src, w, h));
-	return 2;
-}
