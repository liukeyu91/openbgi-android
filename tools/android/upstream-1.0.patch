+/* The fixed-point and vector arithmetic of the later builds: "44" (1.573)
+ * gives the length of a 16.16 vector, "56" and "57" (1.636) multiply and
+ * divide one 16.16 value by another, and "58" .. "5F" do the same over four
+ * lanes of 16 bytes, which the tagged pointers on the stack address.  The
+ * values are chosen so that every step is exact in 16.16. */
+static void TestFixedVectors(OpenBGI_t* o)
+{
+	Asm_t a;
+	Thread_t* t = gT;
+	static const uint32_t kA[4] = {0x20000, 0x30000, 0x40000, 0x50000}; // 2, 3, 4, 5
+	static const uint32_t kB[4] = {0x10000, 0x10000, 0x10000, 0x10000}; // 1, 1, 1, 1
+	uint32_t got[4];
+	char before[0x40];
+	printf("fixed point and vectors\n");
+	// the profile these instructions start in, then back to the earlier one
+	snprintf(before, sizeof before, "%s", o->engine.profile->name);
+	CHECK(Engine_SelectProfile(o, "1.680"));
+	Vm_TablesInit(o);
+
+	// "56" / "57": 16.16 multiply and divide, with the original's truncation
+	a.len = 0;
+	PushI32(&a, 0x18000); // 1.5
+	PushI32(&a, 0x20000); // 2.0
+	Op(&a, 0x56);
+	CHECK(Eval(o, &a) == 0x30000); // 3.0
+	a.len = 0;
+	PushI32(&a, 0x30000); // 3.0
+	PushI32(&a, 0x20000); // 2.0
+	Op(&a, 0x57);
+	CHECK(Eval(o, &a) == 0x18000); // 1.5
+	a.len = 0;
+	PushI32(&a, 0x30000);
+	PushI8(&a, 0);
+	Op(&a, 0x57);
+	CHECK(Eval(o, &a) == 0); // a division by zero gives 0
+
+	// "44": the length of x, y, z in 16.16 (3, 4, 12 → 13)
+	a.len = 0;
+	PushI32(&a, 0x30000);
+	PushI32(&a, 0x40000);
+	PushI32(&a, 0xc0000);
+	Op(&a, 0x44);
+	CHECK(Eval(o, &a) == 0xd0000);
+
+	// the four-lane forms: dst, a, b off the stack, the pointers to locals
+	PutDword(t, 0x10, kA[0]); PutDword(t, 0x14, kA[1]); PutDword(t, 0x18, kA[2]); PutDword(t, 0x1c, kA[3]);
+	PutDword(t, 0x20, kB[0]); PutDword(t, 0x24, kB[1]); PutDword(t, 0x28, kB[2]); PutDword(t, 0x2c, kB[3]);
+#define VEC_CALL(opc) \
+	a.len = 0; \
+	SetFP(&a, 0x40); \
+	Op(&a, 0x04); \
+	A16(&a, 0x40); /* dst: data[0] */ \
+	Op(&a, 0x04); \
+	A16(&a, 0x30); /* a: data[0x10] */ \
+	Op(&a, 0x04); \
+	A16(&a, 0x20); /* b: data[0x20] */ \
+	Op(&a, opc); \
+	PushI8(&a, 1); \
+	CHECK(Eval(o, &a) == 1); \
+	memcpy(got, t->data, sizeof got)
+
+	VEC_CALL(0x58); // 3, 4, 5, 6
+	CHECK(got[0] == 0x30000 && got[1] == 0x40000 && got[2] == 0x50000 && got[3] == 0x60000);
+	VEC_CALL(0x59); // 1, 2, 3, 4
+	CHECK(got[0] == 0x10000 && got[1] == 0x20000 && got[2] == 0x30000 && got[3] == 0x40000);
+	VEC_CALL(0x5a); // 2, 3, 4, 5 times 1
+	CHECK(got[0] == 0x20000 && got[1] == 0x30000 && got[2] == 0x40000 && got[3] == 0x50000);
+	VEC_CALL(0x5b); // the same divided by 1
+	CHECK(got[0] == 0x20000 && got[1] == 0x30000 && got[2] == 0x40000 && got[3] == 0x50000);
+#undef VEC_CALL
+
+	// "5e": dst, src, scale (a 16.16 value, not a pointer): 2, 3, 4, 5 times 2
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x30);
+	PushI32(&a, 0x20000);
+	Op(&a, 0x5e);
+	PushI8(&a, 1);
+	CHECK(Eval(o, &a) == 1);
+	memcpy(got, t->data, sizeof got);
+	CHECK(got[0] == 0x40000 && got[1] == 0x60000 && got[2] == 0x80000 && got[3] == 0xa0000);
+
+	// "5f": dst, src, divisor: the same divided by 2
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x30);
+	PushI32(&a, 0x20000);
+	Op(&a, 0x5f);
+	PushI8(&a, 1);
+	CHECK(Eval(o, &a) == 1);
+	memcpy(got, t->data, sizeof got);
+	CHECK(got[0] == 0x10000 && got[1] == 0x18000 && got[2] == 0x20000 && got[3] == 0x28000);
+
+	// "5d": normalise xyz and keep the length in the fourth cell: (1, 0, 0) → (1, 0, 0, 1)
+	PutDword(t, 0x10, 0x10000); PutDword(t, 0x14, 0); PutDword(t, 0x18, 0); PutDword(t, 0x1c, 0x70000);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x30);
+	Op(&a, 0x5d);
+	PushI8(&a, 1);
+	CHECK(Eval(o, &a) == 1);
+	memcpy(got, t->data, sizeof got);
+	CHECK(got[0] == 0x10000 && got[1] == 0 && got[2] == 0 && got[3] == 0x10000);
+	// a zero vector stays zero, its length too
+	PutDword(t, 0x10, 0); PutDword(t, 0x14, 0); PutDword(t, 0x18, 0); PutDword(t, 0x1c, 0);
+	PutDword(t, 0, 0x11111111); PutDword(t, 4, 0x22222222);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x40);
+	Op(&a, 0x04);
+	A16(&a, 0x30);
+	Op(&a, 0x5d);
