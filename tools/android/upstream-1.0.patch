+
+	CHECK(Engine_SelectProfile(o, before));
+	Vm_TablesInit(o);
+}
+
+/* The instructions 1.680 added to the base set (docs/dev/versions.md), none
+ * of which the earlier builds have.  The immediates of the generation are
+ * signed base-128 values ("03" pushes a count of them, or one of a fixed
+ * width); the local references are 16-bit operands of the offset and a
+ * 2-bit type; "12" moves the frame pointer by an immediate, and the
+ * arithmetic and comparison instructions of the generation fold an
+ * immediate or a local into their operand.  The group selects the profile
+ * itself, then puts the tables of the earlier one back, which must again
+ * have no handler for any of these. */
+static void TestGen680(OpenBGI_t* o)
+{
+	Asm_t a;
+	Thread_t* t = gT;
+	char before[0x40];
+	static const uint8_t kNew[] = {0x03, 0x0d, 0x0e, 0x0f, 0x12, 0x13, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+		0x2c, 0x2d, 0x2e, 0x2f, 0x36, 0x37, 0x3b, 0x3c, 0x64, 0x65};
+	size_t i;
+	printf("1.680\n");
+	snprintf(before, sizeof before, "%s", o->engine.profile->name);
+	CHECK(Engine_SelectProfile(o, "1.680"));
+	Vm_TablesInit(o);
+	CHECK(strcmp(o->engine.profile->name, "1.680") == 0);
+	for(i = 0; i < sizeof kNew; i++)
+		CHECK(o->vm.optablemain[kNew[i]] != NULL);
+
+	// "03": a count of signed base-128 immediates, then one of a fixed width
+	a.len = 0;
+	Op(&a, 0x03);
+	A8(&a, 1); // two values follow
+	ALeb(&a, 5);
+	ALeb(&a, -3);
+	Ret(&a); // (a return at the outermost frame ends the thread and pops nothing)
+	CHECK(Run(o, &a) == 4);
+	CHECK(Depth() == 2 && Top() == (uint32_t)-3 && t->stack[0] == 5);
+	a.len = 0;
+	Op(&a, 0x03);
+	A8(&a, 0x80); // one signed byte
+	A8(&a, 0xfe);
+	CHECK(Eval(o, &a) == 0xfffffffeu);
+	a.len = 0;
+	Op(&a, 0x03);
+	A8(&a, 0x81); // one signed word
+	A16(&a, 0xfffd);
+	CHECK(Eval(o, &a) == 0xfffffffd);
+	a.len = 0;
+	Op(&a, 0x03);
+	A8(&a, 0x82); // one dword
+	A32(&a, 0x11223344);
+	CHECK(Eval(o, &a) == 0x11223344);
+
+	// "0f" / "19": a local is a 16-bit offset from the frame pointer with the type on top
+	a.len = 0;
+	SetFP(&a, 0x40);
+	PushI32(&a, 0x12345678);
+	Op(&a, 0x0f);
+	A16(&a, 0x8010); // dword at fp - 0x10
+	Op(&a, 0x19);
+	A16(&a, 0x8010);
+	CHECK(Eval(o, &a) == 0x12345678);
+	CHECK(memcmp(t->data + 0x30, "\x78\x56\x34\x12", 4) == 0);
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	PushI32(&a, 0x55);
+	Op(&a, 0x0f);
+	A16(&a, 0x0010); // byte at fp - 0x10: only the low byte is written
+	Op(&a, 0x19);
+	A16(&a, 0x0010); // and read back signed
+	CHECK(Eval(o, &a) == 0x55);
+	CHECK(t->data[0x30] == 0x55 && t->data[0x31] == 0x56); // (0x12345678's second byte stays)
+
+	// "0d": a value into the address under it, the type packed with the value
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	Op(&a, 0x04);
+	A16(&a, 0x10); // the address of data[0x30]
+	Op(&a, 0x0d);
+	ALeb(&a, (int32_t)(0x11223344u * 4 + 2)); // dword
+	Op(&a, 0x19);
+	A16(&a, 0x8010);
+	CHECK(Eval(o, &a) == 0x11223344);
+
+	// "0e": the same into a local, the stack kept
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	Op(&a, 0x0e);
+	A16(&a, 0x10); // a plain local offset: the type is the value's, not the operand's
+	ALeb(&a, (int32_t)(0x0badf00du * 4)); // a byte
+	Op(&a, 0x19);
+	A16(&a, 0x0010); // 0x0d is what went in
+	CHECK(Eval(o, &a) == 0x0d);
+
+	// "12": the frame pointer moves by an immediate, and may not leave the data area
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	Op(&a, 0x12);
+	ALeb(&a, 8);
+	Op(&a, 0x10); // push fp
+	CHECK(Eval(o, &a) == 0x48);
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	Op(&a, 0x12);
+	ALeb(&a, -0x10);
+	Op(&a, 0x10);
+	CHECK(Eval(o, &a) == 0x30);
+	{
+		BgiTryFrame_t f;
+		if(BGI_TRY(o, f))
+		{
+			a.len = 0;
+			PushI32(&a, 0x40);
+			Op(&a, 0x11);
+			Op(&a, 0x12);
+			ALeb(&a, 0x1000); // past the data area
+			Ret(&a);
+			Run(o, &a);
+			BGI_END_TRY(o, f);
+			CHECK(!"a frame pointer past the data area must raise");
+		}
+		else
+			CHECK(f.value == BGI_SCRIPT_ERROR_VALUE);
+	}
+
+	// "13": a jump by a signed 16-bit displacement from the opcode's own position
+	a.len = 0;
+	Op(&a, 0x13);
+	A16(&a, 5); // over the value below
+	PushI8(&a, 7);
+	PushI8(&a, 9);
+	CHECK(Eval(o, &a) == 9);
+
+	// "1a" / "1b": a local plus an immediate, and a local times an immediate over the base
+	PutDword(t, 0x30, 0x3264);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x1a);
+	A16(&a, 0x8010); // dword 0x3264
+	ALeb(&a, 6);
+	CHECK(Eval(o, &a) == 0x326a);
+	PutDword(t, 0x30, 3);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	PushI32(&a, 1000);
+	Op(&a, 0x1b);
+	A16(&a, 0x8010);
+	ALeb(&a, 4);
+	CHECK(Eval(o, &a) == 1012);
+
+	// "1c": a local shifted by the signed count after it
+	PutDword(t, 0x30, 3);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x1c);
+	A16(&a, 0x8010);
+	A8(&a, 4);
+	CHECK(Eval(o, &a) == 48);
+	PutDword(t, 0x30, 0xfffffff8); // -8
+	a.len = 0;
+	SetFP(&a, 0x40);
+	Op(&a, 0x1c);
+	A16(&a, 0x8010);
+	A8(&a, 0xff); // -1: an arithmetic shift
+	CHECK(Eval(o, &a) == 0xfffffffc);
+
+	// "1d" / "1e": a value times / divided by a local
+	PutDword(t, 0x30, 7);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	PushI8(&a, 6);
+	Op(&a, 0x1d);
+	A16(&a, 0x8010);
+	CHECK(Eval(o, &a) == 42);
+	a.len = 0;
+	SetFP(&a, 0x40);
+	PushI8(&a, 20);
+	Op(&a, 0x1e);
+	A16(&a, 0x8010);
+	CHECK(Eval(o, &a) == 2);
+	PutDword(t, 0x30, 0); // a division by zero is the least negative value, as "22" does it
+	a.len = 0;
+	SetFP(&a, 0x40);
+	PushI8(&a, 20);
+	Op(&a, 0x1e);
+	A16(&a, 0x8010);
+	CHECK(Eval(o, &a) == 0x80000000u);
+
+	// "1f": a load through the address under the value, with the type packed with the offset
+	t->data[0x30] = 0x11;
+	t->data[0x31] = 0x22;
+	t->data[0x32] = 0x33;
+	t->data[0x33] = 0x44;
+	a.len = 0;
+	PushI32(&a, 0x40);
+	Op(&a, 0x11);
+	Op(&a, 0x04);
+	A16(&a, 0x10); // data[0x30]
+	Op(&a, 0x1f);
+	ALeb(&a, 2); // dword, no offset
+	CHECK(Eval(o, &a) == 0x44332211);
+
+	// "2c" .. "2f": add / multiply / multiply-add / divide by an immediate
+	a.len = 0;
+	PushI8(&a, 10);
+	Op(&a, 0x2c);
+	ALeb(&a, -3);
+	CHECK(Eval(o, &a) == 7);
+	a.len = 0;
+	PushI8(&a, 10);
+	Op(&a, 0x2d);
+	ALeb(&a, 5);
+	CHECK(Eval(o, &a) == 50);
+	a.len = 0;
+	PushI8(&a, 10);
+	PushI8(&a, 3);
+	Op(&a, 0x2e);
+	ALeb(&a, 4);
+	CHECK(Eval(o, &a) == 22);
+	a.len = 0;
+	PushI8(&a, -10);
+	Op(&a, 0x2f);
+	ALeb(&a, 3);
+	CHECK(Eval(o, &a) == 0xfffffffdu);
+	a.len = 0;
+	PushI8(&a, 5);
+	Op(&a, 0x2f);
+	ALeb(&a, 0);
+	CHECK(Eval(o, &a) == 0x80000000u);
+
+	// "36": a comparison of the value with an immediate, the operator in a byte
+	a.len = 0;
+	PushI8(&a, 5);
+	Op(&a, 0x36);
+	A8(&a, 2); // less than
+	ALeb(&a, 7);
+	CHECK(Eval(o, &a) == 1);
+	a.len = 0;
+	PushI8(&a, 5);
+	Op(&a, 0x36);
+	A8(&a, 0); // equal
+	ALeb(&a, 7);
+	CHECK(Eval(o, &a) == 0);
+
+	/* "37" / "3b": a conditional jump by a relative displacement.  The
+	 * low four bits of the condition byte are the operator of "36"; bit 7
+	 * says which way the jump goes: clear, it is taken when the
+	 * comparison is false (how a compiler skips a body), set when it is
+	 * true. */
+	a.len = 0;
+	PushI8(&a, 5);
+	Op(&a, 0x37);
+	A8(&a, 0x00); // equal, and the jump on false
+	A16(&a, 7);   // from the opcode's position
