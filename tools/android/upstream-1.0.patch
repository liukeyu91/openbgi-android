+static uint32_t ReadPackedScalar680(OpenBGI_t* o, Thread_t* t, uint32_t* type)
+{
+	int64_t packed = 0;
+	uint32_t n = t->ip < t->codeUsed ? ReadSignedLeb128(t->code + t->ip, t->codeUsed - t->ip, &packed) : 0;
