-int Wm_StartTimer(OpenBGI_t* o)
-{
-	int r = 0;
-	if(!(o->snd.wmFlags & 1))
-		r = WM_E_NOT_RUNNING;
-	else
-	{
-		o->snd.wmFlags |= 2;
-		o->snd.wmNextTick = Clock_HostMs(o) + 20;
-	}
-	return r;
-}
-
-// stop the fade timer; 0, or 0x14 when the library or the timer is not running
-int Wm_StopTimer(OpenBGI_t* o)
-{
-	int r = 0;
-	if((o->snd.wmFlags & 3) != 3)
-		r = WM_E_NOT_RUNNING;
-	else
-		o->snd.wmFlags &= ~2u;
-	return r;
-}
-
