+static uint32_t ReadLocalOperand(OpenBGI_t* o, Thread_t* t)
+{
+	if(t->ip > t->codeUsed || t->codeUsed - t->ip < 2)
+		ScriptError(o, "Truncated local reference", t);
+	return RdU16(t);
+}
+
+static uint32_t ScalarType(uint32_t type)
+{
+	return type == 3 ? 0 : type;
+}
+
+static uint8_t* LocalSlot(OpenBGI_t* o, Thread_t* t, uint32_t off, uint32_t type)
+{
+	uint32_t fp = Thread_GetFP(t);
+	if(off > fp || fp - off >= t->dataSize || (1u << type) > t->dataSize - (fp - off))
+		ScriptError(o, "Local reference lies outside the data area", t);
+	return t->data + (fp - off);
+}
+
+static uint8_t* ReadLocalSlot(OpenBGI_t* o, Thread_t* t, uint32_t* type)
+{
+	uint32_t operand = ReadLocalOperand(o, t);
+	*type = ScalarType(operand >> 14);
+	return LocalSlot(o, t, operand & 0x3fff, *type);
+}
