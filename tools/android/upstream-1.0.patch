+static void SetCheckedFP(OpenBGI_t* o, Thread_t* t, uint32_t v)
+{
+	if(v >= t->dataSize)
+	{
+		char msg[0x100];
+		sprintf(msg, MSG_SP_OUT_OF_RANGE, (unsigned)v);
+		ScriptError(o, msg, t);
+	}
+	Thread_SetFP(t, v);
