+/*
+ * This file is part of OpenBGI (https://openbgi.net).
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * textcp.h - the CP936 (GBK) and CP950 (Big5) code pages, for the text
+ *            encodings a translated script uses (src/core/textcp.c)
+ *
+ * The original engine knows Shift-JIS and UTF-8 only.  The Android fork adds
+ * two more modes for translated games, whose script text is Chinese in GBK or
+ * Big5, and this is the code page side of them: the two-byte sequence tests
+ * and the code <-> Unicode lookups that TextGetCharMode, TextTableChar and the
+ * font layer need.
+ */
+#ifndef BGI_TEXTCP_H_
+#define BGI_TEXTCP_H_
+
+#include "bgi/common.h"
+
+int TextCp_GbkCharLen(const char* s);              // 2 for a mapped two-byte GBK sequence, else 1
+int TextCp_Big5CharLen(const char* s);             // 2 for a mapped two-byte Big5 sequence, else 1
+uint32_t TextCp_GbkToCodePoint(uint16_t code);     // a packed GBK code -> the Unicode scalar (0xfffd unmapped)
+uint32_t TextCp_Big5ToCodePoint(uint16_t code);    // a packed Big5 code -> the Unicode scalar (0xfffd unmapped)
+uint16_t TextCp_CodePointToGbk(uint32_t cp);       // the packed GBK code; 0 when the code page has none
+uint16_t TextCp_CodePointToBig5(uint32_t cp);      // the packed Big5 code; 0 when the code page has none
+
+#endif
