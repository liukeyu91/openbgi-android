+// append a signed base-128 value (the immediate form of the 1.680 instructions)
+static void ALeb(Asm_t* a, int32_t v)
+{
+	for(;;)
+	{
+		uint8_t b = (uint8_t)(v & 0x7f);
+		int sign = (b & 0x40) != 0;
+		v >>= 7;
+		if((v == 0 && !sign) || (v == -1 && sign))
+		{
+			A8(a, b);
+			return;
+		}
+		A8(a, b | 0x80);
+	}
+}
