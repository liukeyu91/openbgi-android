+		a = (FaceAdjust_t*)BGI_Calloc(sizeof *a);
+		snprintf(a->face, sizeof a->face, "%s", face);
+		a->next = o->ops.faceAdjust;
+		o->ops.faceAdjust = a;
+	}
+	a->sx = sx;
+	a->sy = sy;
+	a->dx = dx;
+	a->dy = dy;
+	a->spacing = spacing;
+	return 0;
