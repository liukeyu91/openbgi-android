-{
-	for(; *a && *b; a++, b++)
-	{
-		int x = (uint8_t)*a, y = (uint8_t)*b;
-		if(x >= 'A' && x <= 'Z')
-			x += 32;
-		if(y >= 'A' && y <= 'Z')
-			y += 32;
-		if(x != y)
-			return 0;
-	}
-	return !*a && !*b;
-}
