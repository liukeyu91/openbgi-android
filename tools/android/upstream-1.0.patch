+static int32_t ReadLeb32(OpenBGI_t* o, Thread_t* t)
+{
+	int64_t value = 0;
+	uint32_t n = t->ip < t->codeUsed ? ReadSignedLeb32(t->code + t->ip, t->codeUsed - t->ip, &value) : 0;
+	if(!n)
+		ScriptError(o, "Invalid signed variable-length operand", t);
+	t->ip += n;
+	return (int32_t)value;
+}
